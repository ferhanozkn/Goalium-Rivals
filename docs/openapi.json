components:
  schemas:
    ActorTypeEnum:
      enum:
      - guest
      - user
      type: string
      description: |-
        * `guest` - guest
        * `user` - user
    AuthResponse:
      type: object
      properties:
        user:
          $ref: '#/components/schemas/User'
        tokens:
          $ref: '#/components/schemas/TokenPair'
      required:
      - tokens
      - user
    DifficultyEnum:
      enum:
      - easy
      - medium
      - hard
      type: string
      description: |-
        * `easy` - Easy
        * `medium` - Medium
        * `hard` - Hard
    DuelCreate:
      type: object
      properties:
        language:
          allOf:
          - $ref: '#/components/schemas/Language906Enum'
          default: tr
        modes:
          type: array
          items:
            $ref: '#/components/schemas/ModesEnum'
    DuelResponse:
      type: object
      properties:
        match:
          $ref: '#/components/schemas/Match'
        participant_id:
          type: string
          format: uuid
        round:
          nullable: true
        expires_at:
          type: string
          format: date-time
          nullable: true
      required:
      - expires_at
      - match
      - participant_id
      - round
    GameSession:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        kind:
          allOf:
          - $ref: '#/components/schemas/KindEnum'
          readOnly: true
        modes:
          readOnly: true
        language:
          allOf:
          - $ref: '#/components/schemas/Language88eEnum'
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/GameSessionStatusEnum'
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        finished_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        deadline:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - deadline
      - finished_at
      - id
      - kind
      - language
      - modes
      - started_at
      - status
    GameSessionStatusEnum:
      enum:
      - waiting
      - active
      - finished
      - expired
      type: string
      description: |-
        * `waiting` - Waiting
        * `active` - Active
        * `finished` - Finished
        * `expired` - Expired
    GuestSessionCreate:
      type: object
      properties:
        display_name:
          type: string
          default: ''
          maxLength: 80
    GuestSessionResponse:
      type: object
      properties:
        guest_token:
          type: string
        guest_session_id:
          type: string
          format: uuid
        display_name:
          type: string
        expires_at:
          type: string
          format: date-time
      required:
      - display_name
      - expires_at
      - guest_session_id
      - guest_token
    ImportJob:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        provider:
          allOf:
          - $ref: '#/components/schemas/ImportJobProviderEnum'
          readOnly: true
        source_url:
          type: string
          format: uri
          readOnly: true
        license_name:
          type: string
          readOnly: true
        license_status:
          allOf:
          - $ref: '#/components/schemas/LicenseStatus56aEnum'
          readOnly: true
        status:
          allOf:
          - $ref: '#/components/schemas/ImportJobStatusEnum'
          readOnly: true
        record_count:
          type: integer
          readOnly: true
        imported_count:
          type: integer
          readOnly: true
        skipped_count:
          type: integer
          readOnly: true
        error_count:
          type: integer
          readOnly: true
        error_message:
          type: string
          readOnly: true
        started_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        finished_at:
          type: string
          format: date-time
          readOnly: true
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - error_count
      - error_message
      - finished_at
      - id
      - imported_count
      - license_name
      - license_status
      - provider
      - record_count
      - skipped_count
      - source_url
      - started_at
      - status
    ImportJobProviderEnum:
